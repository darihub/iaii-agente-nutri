# Copiá este archivo como ".env" y completalo. El archivo .env NO se sube a GitHub.

# Clave de Groq (empieza con gsk_...). Si la dejás vacía, el programa te la pide al iniciar.
GROQ_API_KEY=

# Webhook de n8n. Para recordatorios usar la URL de PRODUCCIÓN (/webhook/...) con el workflow ACTIVADO.
# Si no lo definís, se usa la URL de prueba que tenía el notebook.
N8N_WEBHOOK_URL=https://tu-instancia.app.n8n.cloud/webhook/tu-path

# Correo de destino de los recordatorios (opcional). Vacío = el que tenga configurado el nodo Gmail de n8n.
EMAIL_DESTINO=

# PDFs a indexar, separados por coma. Rutas relativas a la raíz del proyecto.
# Por defecto: data/LIBRO1.pdf,data/LIBRO2.pdf
# PDF_PATHS=data/LIBRO1.pdf,data/LIBRO2.pdf

# Modelos (opcionales).
# GROQ_MODEL=openai/gpt-oss-20b
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL=linhha2705/multilingual-e5-nutrition
